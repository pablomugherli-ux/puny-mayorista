# ============================================================================
# PUNY Mayorista — variables de entorno de ejemplo
# Copiar a ".env.local" (frontend) y completar con valores reales antes de
# cada build. Nunca commitear ".env.local" ni valores reales de este archivo.
# ============================================================================

# --- Frontend (Next.js, build-time — deben empezar con NEXT_PUBLIC_) -------
# URL y anon key del proyecto Supabase. La anon key es pública por diseño:
# el control de acceso real lo hace Row Level Security en la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# --- Secretos de la Edge Function "whatsapp-agent" (Supabase Dashboard >
# Edge Functions > whatsapp-agent > Secrets, o `supabase secrets set`) ------
# Funcionan como RESPALDO GLOBAL: cada distribuidora puede cargar sus propias
# credenciales desde Admin > Agente IA de WhatsApp, que tienen prioridad. Si
# un tenant no cargó las suyas, se usan estas.
# ============================================================================
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Proveedor de IA que redacta las respuestas del agente de WhatsApp.
ANTHROPIC_API_KEY=

# Provistos automáticamente por Supabase en cada Edge Function — no hace
# falta cargarlos a mano, se documentan acá solo como referencia.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# --- AFIP (Facturación Electrónica — WSFE) ----------------------------------
# Pendiente de implementación: hoy Admin > Integraciones solo guarda
# metadatos (CUIT, punto de venta, entorno). Cuando haya certificado/clave
# privada reales, NO van acá como texto plano — se suben a un bucket privado
# de Supabase Storage o se cargan como secreto de Edge Function dedicado.
# AFIP_CUIT=
# AFIP_ENTORNO=testing   # testing | produccion
# AFIP_PUNTO_VENTA=

# ============================================================================
# --- Tango ERP ---------------------------------------------------------------
# Pendiente de implementación: depende de si la integración es por archivo
# (exportación/importación en formato de interfaz de Tango) o por Tango API /
# RemoteObjects (requiere licencia de API de la instalación de Tango).
# TANGO_ENDPOINT_URL=
# TANGO_API_KEY=

# ============================================================================
# --- Netlify (deploy) --------------------------------------------------------
# No se usan como variables de entorno del build — se pasan como parámetros
# al comando `netlify deploy`. Se documentan acá para referencia del sitio.
# NETLIFY_SITE_ID=88095566-0044-47f8-9483-5d7a9a7cee1a
